{
  "name": "full-stack-web-application",
  "version": "1.0.0",
  "description": "Full stack web application for Tedu",
  "main": "index.js",
  "scripts": {
    "db:migration": "./node_modules/.bin/ts-node migrations/index.ts up",
    "server:dev": "nodemon --config nodemon.json app.ts",
    "start": "npm run db:migration  && node --unhandled-rejections=strict ./dist/app.js",
    "debug": "export DEBUG=* && npm run start",
    "test": "ENV_FILE=./.env.test && mocha -r ts-node/register 'tests/**/*.test.ts' --timeout 20000 --unhandled-rejections=strict --exit",
    "build": "npx tsc"
  },
  "keywords": [],
  "author": "Kiet Pham",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "debug": "^4.3.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "express-winston": "^4.2.0",
    "joi": "^17.13.3",
    "mongo-migrate-ts": "^1.6.0",
    "mongoose": "^8.4.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.16",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.7",
    "@types/supertest": "^6.0.2",
    "chai": "^5.1.1",
    "mocha": "^10.4.0",
    "nodemon": "^3.1.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "typescript": "^5.5.2"
  }
}